# Database — SQLite for local dev, PostgreSQL for production
# SQLite (default for local dev):
DATABASE_URL=sqlite+aiosqlite:///./acme_salary.db

# PostgreSQL (when available):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/acme_salary

# AI Provider (optional — app works in demo mode without this)
GEMINI_API_KEY=

# Application settings
APP_ENV=development
SECRET_KEY=dev-secret-key-change-in-production
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Demo mode — always true unless GEMINI_API_KEY is set
DEMO_MODE=true

